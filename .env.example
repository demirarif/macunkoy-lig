# --- Oturum imzalama anahtari (en az 32 karakter) ---
# Degisirse herkesin oturumu kapanir.
SESSION_SECRET=en-az-32-karakterlik-rastgele-bir-dizi

# --- Admin hesabi ---
# Veritabaninda TUTULMAZ, sadece burada yasar.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=guclu-bir-sifre

# --- Supabase (yayin icin) ---
# Bos birakilirsa uygulama yerel .data/league.json dosyasini kullanir.
# Ikisi de doluysa Supabase'e baglanir.
# service_role anahtari tam yetkilidir: asla tarayiciya gitmemeli,
# asla NEXT_PUBLIC_ on ekiyle tanimlanmamali.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=